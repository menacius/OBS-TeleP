    <file alias="stop.svg">icons/stop.svg</file>
    <file alias="restart.svg">icons/restart.svg</file>
    <file alias="previous.svg">icons/previous.svg</file>
    <file alias="next.svg">icons/next.svg</file>
  </qresource>
</RCC>
